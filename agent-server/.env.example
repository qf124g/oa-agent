# 大模型与 Embedding 接入配置（OpenAI 兼容协议）
# 阿里云百炼 DashScope 兼容模式端点，可切换智谱/DeepSeek 等
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=替换为你的真实APIKey
OPENAI_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# agent 服务端口
PORT=3002

# 平台后端地址（Node.js 后端）
PLATFORM_API_BASE=http://localhost:8080

# RAG 检索返回的文本块数量
KNOWLEDGE_TOP_K=4

# 领域事件内部回调密钥（backend → agent-server 的 /internal/events 鉴权，两端需保持一致）
INTERNAL_SECRET=dev-internal-secret